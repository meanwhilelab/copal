# Copal core configuration — copy to .env and fill in
DATABASE_URL=postgres://copal:copal@localhost:5433/copal
PORT=8787
HOST=0.0.0.0
# Comma-free plain values; never commit real tokens.

# Housekeeper (step 4) — omit keys to leave jobs queued.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Ordered, provider-agnostic failover chain (main → fallback 1 → …). Preferred
# over the single-model vars below, which remain supported for older configs.
# HOUSEKEEPER_MODELS="gemini:gemini-3.1-flash-lite, anthropic:claude-haiku-4-5"
# HOUSEKEEPER_PROVIDER=gemini   # gemini | anthropic
# HOUSEKEEPER_MODEL=gemini-3.1-flash-lite
# HOUSEKEEPER_DAILY_CAP_EUR=1.0

# Semantic search + resonance (embeddings). Unset = lexical search only.
# OPENAI_API_KEY=

# Linear: lets a board item track any number of Linear issues, each refreshed
# with its sub-issue tree on every context compile. Unset = issues can still be
# tracked, but nothing is fetched or stored.
# LINEAR_API_KEY=

# Docker only: the EXTERNAL reverse-proxy network the app joins, so a proxy can
# `reverse_proxy copal:8787`. Defaults to caddy_default.
# CADDY_NETWORK=caddy_default
